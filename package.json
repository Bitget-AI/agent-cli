{
  "name": "bitget-agent-cli",
  "version": "1.2.0",
  "description": "bgc — the official Bitget shell CLI. Run any of 56+ Bitget API tools (spot, futures, margin, copy-trading, earn, broker, p2p, convert, account) from your terminal or shell-based AI assistant (Claude Code, Codex CLI, OpenClaw).",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "bgc": "./dist/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "bitget",
    "bitget-api",
    "bitget-cli",
    "bgc",
    "trading",
    "crypto",
    "cryptocurrency",
    "exchange",
    "spot",
    "futures",
    "margin",
    "cli",
    "ai-agent",
    "claude-code",
    "codex",
    "openclaw"
  ],
  "homepage": "https://github.com/bitget/agent-hub",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitget/agent-cli.git"
  },
  "bugs": {
    "url": "https://github.com/bitget/agent-cli/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "dependencies": {
    "bitget-agent-sdk": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  }
}
