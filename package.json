{
  "name": "bitget-client",
  "version": "1.2.0",
  "description": "bgc — the Bitget CLI. Run any of 56+ Bitget API tools from your shell or shell-based AI assistant (Claude Code, Codex CLI, OpenClaw).",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "bgc": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run typecheck && pnpm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "bitget",
    "cli",
    "bgc",
    "trading",
    "crypto",
    "ai-agent"
  ],
  "homepage": "https://github.com/bitget/agent-hub",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitget/agent-cli.git"
  },
  "bugs": {
    "url": "https://github.com/bitget/agent-cli/issues"
  },
  "dependencies": {
    "bitget-agent-sdk": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  }
}
